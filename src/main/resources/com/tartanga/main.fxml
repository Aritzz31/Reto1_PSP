<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tartanga.MainController">
   <children>
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Label contentDisplay="CENTER" text="IP: " />
            <TextField fx:id="txtIP" promptText="127.0.0.1">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin></TextField>
            <Label text="Puerto: " />
            <TextField fx:id="txtPort" promptText="5000">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin></TextField>
            <Label text="Usuario: " />
            <TextField fx:id="txtUser" promptText="Duxon">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin></TextField>
            <Button fx:id="btnConnect" mnemonicParsing="false" text="Conectar" />
            <Button fx:id="btnDisconnect" disable="true" mnemonicParsing="false" text="Desconectar" />
            <Label fx:id="lblConnected" text="No conectado" textFill="RED">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
         </children>
      </HBox>
      <ListView prefHeight="400.0" prefWidth="200.0" />
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <CheckBox fx:id="chkPrivate" mnemonicParsing="false" text="Privado" />
            <Label text="Para: " />
            <ComboBox fx:id="cmbPrivateUser" prefWidth="150.0" promptText="Usuario" />
            <TextField fx:id="txtMessage" prefHeight="26.0" prefWidth="550.0" promptText="Mensaje" />
            <Button fx:id="txtSend" mnemonicParsing="false" text="Enviar" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
